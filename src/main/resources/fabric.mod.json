{
  "schemaVersion": 1,
  "id": "manuai",
  "version": "${version}",
  "name": "ManuAI",
  "description": "Autonomer KI-Survival-Mitspieler für Minecraft",
  "authors": [
    "DerEineTypDa"
  ],
  "contact": {
    "homepage": "https://github.com/DerEineTypDa/ManuAI",
    "sources": "https://github.com/DerEineTypDa/ManuAI"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.manuai.ManuAIMod"
    ],
    "client": [
      "de.manuai.client.ManuAIClient"
    ]
  },
  "mixins": [
    "manuai.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
